# ==============================================================================
# Vocalis Configuration Environment Variables
# ==============================================================================
# To use:
#   cp .env_example .env
#   chmod 600 .env
# ==============================================================================

# [REQUIRED] Groq API Key
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# [OPTIONAL] Default Refinement Mode
# Options:
#   prose  - Cleans filler words ("um", "ah"), auto-punctuates for notes, comments, commits (default)
#   code   - Formats programming syntax, camelCase/snake_case, functions, docstrings
#   prompt - Turns rambling voice notes into structured prompts for Cursor/Copilot/Claude
#   raw    - Direct verbatim Whisper transcription without LLM rewriting
VOCALIS_MODE=prose

# [OPTIONAL] Groq Speech-to-Text (STT) Model
# Options:
#   whisper-large-v3-turbo - Ultra fast (~150-250ms), highly accurate (default)
#   whisper-large-v3       - Standard large model
VOCALIS_STT_MODEL=whisper-large-v3-turbo

# [OPTIONAL] Groq Large Language Model (LLM) for Refinement
# Options:
#   openai/gpt-oss-120b     - High capability reasoning & formatting (default)
#   llama-3.3-70b-versatile - High intelligence and precision
#   llama-3.1-8b-instant    - Blazing fast low latency
VOCALIS_LLM_MODEL=openai/gpt-oss-120b

# [OPTIONAL] Spoken Language Code
# Options: en, es, fr, de, it, pt, etc. (or 'auto' for automatic detection)
VOCALIS_LANGUAGE=en

# [OPTIONAL] Silence Detection Hangover (seconds)
# Duration of silence to wait after speech before completing recording (default: 0.9)
VOCALIS_SILENCE_DURATION=0.9

# [OPTIONAL] Voice Activity Detection Energy Threshold
# Base RMS volume threshold to register speech activity (default: 0.012)
VOCALIS_ENERGY_THRESHOLD=0.012
